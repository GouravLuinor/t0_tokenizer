{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "NorAI Design Tokens",
  "version": "3.1.0",
  "theme": "obsidian-graphite",
  "tokens": {
    "colors": {
      "background": "#09090B",
      "surface": {
        "subtle": "#121215",
        "default": "#18181B",
        "elevated": "#222226",
        "border": "#27272A",
        "borderHover": "#3F3F46"
      },
      "brand": {
        "emerald": "#10B981",
        "cyan": "#06B6D4",
        "violet": "#8B5CF6",
        "amber": "#F59E0B",
        "rose": "#F43F5E"
      },
      "bpe": {
        "cycle": [
          { "name": "emerald", "bg": "rgba(16, 185, 129, 0.12)", "border": "rgba(16, 185, 129, 0.25)", "text": "#34D399" },
          { "name": "cyan", "bg": "rgba(6, 182, 212, 0.12)", "border": "rgba(6, 182, 212, 0.25)", "text": "#22D3EE" },
          { "name": "violet", "bg": "rgba(139, 92, 246, 0.12)", "border": "rgba(139, 92, 246, 0.25)", "text": "#A78BFA" },
          { "name": "amber", "bg": "rgba(245, 158, 11, 0.12)", "border": "rgba(245, 158, 11, 0.25)", "text": "#FBBF24" },
          { "name": "rose", "bg": "rgba(244, 63, 94, 0.12)", "border": "rgba(244, 63, 94, 0.25)", "text": "#FB7185" }
        ]
      }
    },
    "spacing": {
      "grid": 8,
      "subGrid": 4
    },
    "typography": {
      "fontSans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "fontMono": "'JetBrains Mono', 'Fira Code', Menlo, Monaco, Consolas, monospace"
    }
  }
}
